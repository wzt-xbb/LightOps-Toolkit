#LightOps runtime configuration

#Thresholds
CPU_WARN=80
MEM_WARN=80
DISK_WARN=80

#Paths
REPORT_DIR=/opt/lightops/reports
LOG_DIR=/opt/lightops/logs
BACKUP_DIR=/opt/lightops/backups/mysql

#MySQL
MYSQL_CNF=/opt/lightops/mysql/my.cnf
MYSQL_DATABASE=lightops_demo
RETENTION_DAYS=7

# Port monitor
PORT_TIMEOUT=2
